# ==============================================================================
# DIGITAL LIBRARY MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and populate with your environment-specific credentials.
# NEVER commit the active .env file containing live secrets into version control.

# Application Profile & Server
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
SERVER_TIMEZONE=Asia/Kolkata

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_library
DB_USER=postgres
DB_PASSWORD=postgres_secure_password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# Security & JWT Tokens
# Generate a strong 256-bit secret key (min 32 characters)
JWT_SECRET=super_secret_production_key_minimum_32_characters_long_for_hmac256
JWT_EXPIRATION_MS=3600000          # 1 hour
JWT_REFRESH_EXPIRATION_MS=2592000000 # 30 days

# Razorpay Payment Gateway Configuration (India)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretKeyHere
RAZORPAY_CURRENCY=INR

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_CONFIG_PATH=/app/config/firebase-service-account.json
FIREBASE_PROJECT_ID=digital-library-prod

# Email Notification Provider (SMTP / SendGrid)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notifications@digitallibrary.local
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=notifications@digitallibrary.local

# Library Default Policy Overrides
DEFAULT_MONTHLY_FEE=700.00
DEFAULT_GRACE_PERIOD_DAYS=7
DEFAULT_ATTENDANCE_BLOCK_DAYS=8
DEFAULT_SEAT_RELEASE_DAYS=15
DEFAULT_RESERVATION_TIMEOUT_MINUTES=10
